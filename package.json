{
  "name": "archivo-fork",
  "version": "1.5.0-beta.3",
  "description": "Offline catalogs, scheduled rescans, storage maps and verified duplicates",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "test": "electron test/smoke.js",
    "test:scanner": "node test/scanner.test.js",
    "build:mac": "electron-builder --mac --arm64 --publish never",
    "build:mac-universal": "electron-builder --mac --universal --publish never",
    "build:win": "electron-builder --win --x64 --publish never",
    "test:unit": "node --test test/*.test.js",
    "test:features": "node test/features.js",
    "build:mac:test": "electron-builder --mac --arm64 --publish never",
    "test:background": "node test/background.js",
    "check": "node scripts/check.js",
    "test:polish": "node test/polish.js",
    "test:advanced": "node test/advanced-ui.js"
  },
  "build": {
    "appId": "com.tannerfugal.archivofork",
    "productName": "Archivo Fork",
    "copyright": "Copyright \u00a9 2026 just edit",
    "files": [
      "src/**/*",
      "build/icon.icns",
      "build/icon.ico"
    ],
    "directories": {
      "output": "dist"
    },
    "mac": {
      "category": "public.app-category.utilities",
      "icon": "build/icon.icns",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64"
          ]
        }
      ],
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "notarize": false,
      "extendInfo": {
        "NSRemovableVolumesUsageDescription": "archivo needs access to your external drives to catalog what is on them.",
        "NSNetworkVolumesUsageDescription": "archivo needs access to network volumes to catalog what is on them.",
        "NSDesktopFolderUsageDescription": "archivo needs access to your Desktop to open and save catalog files stored there.",
        "NSDocumentsFolderUsageDescription": "archivo needs access to your Documents folder to open and save catalog files stored there.",
        "NSDownloadsFolderUsageDescription": "archivo needs access to your Downloads folder to open and save catalog files stored there.",
        "NSCameraUsageDescription": null,
        "NSMicrophoneUsageDescription": null,
        "NSBluetoothAlwaysUsageDescription": null,
        "NSBluetoothPeripheralUsageDescription": null,
        "NSAudioCaptureUsageDescription": null
      }
    },
    "dmg": {
      "title": "Archivo Fork 1.5.0 beta 3",
      "icon": null,
      "internetEnabled": false,
      "writeUpdateInfo": false,
      "contents": [
        {
          "x": 130,
          "y": 220
        },
        {
          "x": 410,
          "y": 220,
          "type": "link",
          "path": "/Applications"
        }
      ],
      "license": null
    },
    "win": {
      "icon": "build/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Archivo Fork",
      "license": "LICENSE.txt"
    },
    "extraResources": [
      {
        "from": "LICENSE",
        "to": "LICENSE"
      }
    ]
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "electron": "^43.0.0",
    "electron-builder": "^26.0.0"
  },
  "author": "just edit",
  "license": "GPL-3.0-or-later",
  "repository": {
    "type": "git",
    "url": "https://github.com/tannerfugal/archivo.git"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
